/target
.env
*.swp
*.swo
.DS_Store
node_modules/
frontend/dist/
.sqlx/

# Generated by scripts/asset-manifest.sh; signed and published as a
# release artefact rather than committed.
/assets-manifest.json
/assets-manifest.sigstore.json
/local-manifest.json

# Playwright run output. Created by `pnpm test` in tests/e2e and by the
# e2e CI job, which uploads playwright-report/ as an artefact.
tests/e2e/test-results/
tests/e2e/playwright-report/

# pnpm creates a store beside the project when none is configured.
.pnpm-store/

# Python bytecode, which `reuse lint` counts as an unlicensed file.
__pycache__/
*.pyc
