// Cedar schema for Noombat.

namespace Noombat {
    entity Actor;

    entity Profile in [Actor];

    entity ProfileSection in [Profile];

    entity Post in [Actor];

    entity JobListing in [Actor];

    entity Group in [Actor];

    entity Event in [Actor];

    entity Report;

    entity Instance;

    // Common context record carried with every authorisation request.
    type AuthContext = {
        is_owner: String,
        visibility?: String,
        cv_download?: String,
        is_follower?: String,
        discoverable?: String,
        federate_profile?: String,
        instance_role?: String,
        group_role?: String,
    };

    action "view" appliesTo {
        principal: [Actor],
        resource: [Profile, ProfileSection, Post, JobListing, Group, Event],
        context: AuthContext,
    };

    action "edit" appliesTo {
        principal: [Actor],
        resource: [Profile, ProfileSection, Post, JobListing, Group, Event],
        context: AuthContext,
    };

    action "delete" appliesTo {
        principal: [Actor],
        resource: [Profile, ProfileSection, Post, JobListing, Group, Event],
        context: AuthContext,
    };

    action "create_post" appliesTo {
        principal: [Actor],
        resource: [Profile],
        context: AuthContext,
    };

    action "download_cv" appliesTo {
        principal: [Actor],
        resource: [Profile],
        context: AuthContext,
    };

    action "manage_sections" appliesTo {
        principal: [Actor],
        resource: [Profile],
        context: AuthContext,
    };

    action "manage_job" appliesTo {
        principal: [Actor],
        resource: [JobListing],
        context: AuthContext,
    };

    action "search_index" appliesTo {
        principal: [Actor],
        resource: [Profile],
        context: AuthContext,
    };

    action "federate_profile_data" appliesTo {
        principal: [Actor],
        resource: [Profile],
        context: AuthContext,
    };

    // ..... Group actions .....

    action "post_to_group" appliesTo {
        principal: [Actor],
        resource: [Group],
        context: AuthContext,
    };

    action "moderate" appliesTo {
        principal: [Actor],
        resource: [Group],
        context: AuthContext,
    };

    action "manage_members" appliesTo {
        principal: [Actor],
        resource: [Group],
        context: AuthContext,
    };

    // ..... Instance moderation actions .....

    action "report" appliesTo {
        principal: [Actor],
        resource: [Post, Profile],
        context: AuthContext,
    };

    action "resolve_report" appliesTo {
        principal: [Actor],
        resource: [Report],
        context: AuthContext,
    };

    action "suspend_actor" appliesTo {
        principal: [Actor],
        resource: [Profile],
        context: AuthContext,
    };

    action "configure_instance" appliesTo {
        principal: [Actor],
        resource: [Instance],
        context: AuthContext,
    };
}
