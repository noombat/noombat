# Rust build output (built inside the container).
target/

# Frontend build output (built inside the container by the
# frontend stage; host-side artifacts must not leak into the
# image and shadow the production build).
frontend/dist/
frontend/node_modules/

# Version control and editor files. The glob as well as the top-level
# entry, because nested repositories exist and are not covered by `.git/`.
.git/
**/.git/
.gitignore
*.swp
*.swo
.DS_Store

# Environment files (may contain secrets).
.env
.env.test

# CI and documentation (not needed at runtime).
.github/
docs/
tests/
*.md
!README.md

# SQLx offline cache.
.sqlx/

# Private, and its own repository. Never part of a build context or an
# image layer.
docs-extra/

# Agent tooling, kept out of git and out of images alike.
.scratch/
