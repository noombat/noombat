# Environment configuration for a local test server.
# No released container images are used; all services are built from source.
#
# Usage:
#   cp .env.test .env
#
#   # REQUIRED — regenerate all secrets before first use:
#   sed -i "s|^NOOMBAT_JWT_SECRET=.*|NOOMBAT_JWT_SECRET=$(openssl rand -base64 48)|" .env
#   sed -i "s|^CHATMAIL_ADMIN_SECRET=.*|CHATMAIL_ADMIN_SECRET=$(openssl rand -hex 32)|" .env
#   sed -i "s|^MEILI_MASTER_KEY=.*|MEILI_MASTER_KEY=$(openssl rand -hex 16)|" .env
#
#   On macOS (BSD sed), use sed -i '' instead of sed -i.

# --- Instance ---

# Domain name. For a LAN-only test server, "localhost" suffices.
# For a publicly reachable test instance behind a reverse proxy,
# replace with the actual FQDN (e.g. test.noombat.example).
NOOMBAT_DOMAIN=localhost

# PostgreSQL connection URL.
# The hostname "db" resolves only inside the Compose network.
# compose.yml hardcodes this value in the noombat service's
# environment block, so this line serves as documentation.
# For host-side tooling (e.g. `sqlx migrate run`), use
# postgres://noombat:noombat@localhost/noombat instead.
NOOMBAT_DATABASE_URL=postgres://noombat:noombat@db/noombat

# Open registration for testing. Set to false to require invitations.
NOOMBAT_OPEN_REGISTRATIONS=true

# --- Authentication ---

# JWT secret (HS256, >= 32 bytes). MUST be regenerated before use;
# the placeholder below is not secret.
NOOMBAT_JWT_SECRET=CHANGE-ME-run-openssl-rand-base64-48-to-generate

# Access-token lifetime: 15 min (default).
NOOMBAT_ACCESS_TTL_SECS=900

# Refresh-token lifetime: 30 days (default).
NOOMBAT_REFRESH_TTL_SECS=2592000

# --- Search ---

MEILI_MASTER_KEY=noombat-test-meili-key

# --- Chat (Chatmail) ---

# NOOMBAT_CHATMAIL_DOMAIN is derived by compose.yml as
# chat.${NOOMBAT_DOMAIN}; it is not read from this file.
# NOOMBAT_CHATMAIL_ADMIN_URL is hardcoded in compose.yml to
# http://chatmail:9100 (the Compose-internal service address).
# Neither variable needs to be set here.

CHATMAIL_ADMIN_SECRET=noombat-test-chatmail-secret

# The production allowlist at noombat.org will not include a test
# server's domain. Inter-instance Chatmail delivery therefore fails
# until the domain is registered. For isolated testing, override
# with a locally served allowlist JSON or leave the default and
# accept that outbound chat to other instances will be rejected.
# CHATMAIL_ALLOWLIST_URL=http://host.docker.internal:8080/allowlist.json

# --- Logging ---

# Forwarded to the container by compose.test.yml.
RUST_LOG=info,noombat=debug,tower_http=debug

# --- Development admin token ---
# Intentionally omitted. The test server authenticates via JWT only,
# matching production behaviour.
#
# Note: the container image does not include noombat.toml, and
# neither Compose file references NOOMBAT_ADMIN_TOKEN, so the server
# has no admin_token by default. The smoke-test.sh "POST outbox for
# nonexistent user returns 404" case requires the token on both the
# server (via a temporary Compose override) and the client (exported
# shell variable). See the deployment guide for the full workaround.
# Health, WebFinger, and NodeInfo checks pass without it.
# NOOMBAT_ADMIN_TOKEN=noombat
