# noombat-chatmail container image.
#
# Packages the standard Chatmail relay (Postfix + Dovecot + doveauth +
# filtermail + OpenDKIM) alongside the noombat-chatmail-admin sidecar
# daemon, managed by s6-overlay.

# Base images are pinned by digest as well as by tag.
# The digest makes the input immutable and is a prerequisite for the
# reproducibility gate in CI. Dependabot proposes digest bumps for review.
#
# Refresh a digest with:
#   docker buildx imagetools inspect <image>:<tag>

# ..... RUST BUILD .....
#
# Builds both the sidecar daemon and the filtermail content filter
# as release binaries.
FROM rust:1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS rust-builder

WORKDIR /build
COPY Cargo.toml Cargo.lock* rust-toolchain.toml ./
COPY crates/ crates/

# Build the sidecar and filtermail binaries in release mode.
RUN cargo build --release --bin noombat-chatmail-admin --bin noombat-filtermail

# ..... RUNTIME .....
#
# Base image: Debian bookworm-slim with the mail stack installed via
# packages. In production, the upstream Chatmail relay is deployed via
# Ansible (cmdeploy); for containerisation, we install the required
# packages directly and overlay the Chatmail-specific configuration.
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

# Install s6-overlay for process supervision.
ARG S6_OVERLAY_VERSION=3.2.0.2

# SHA-256 of the two release archives, each cross-checked against the
# .sha256 file upstream publishes beside it.
#
# `ADD` fetches over HTTPS but verifies nothing, so a substituted or
# tampered release asset would have been unpacked as root without
# complaint. A version tag is not an integrity check: GitHub release
# assets are mutable in principle, and TLS authenticates the host, not
# the artefact.
#
# Verification is a separate `RUN` using sha256sum from coreutils, which
# bookworm-slim already provides.
#
# To refresh after a version bump:
#   curl -fsSL <url>.sha256
ARG S6_NOARCH_SHA256=6dbcde158a3e78b9bb141d7bcb5ccb421e563523babbe2c64470e76f4fd02dae
ARG S6_X86_64_SHA256=59289456ab1761e277bd456a95e737c06b03ede99158beb24f12b165a904f478

ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz /tmp

# Verify before extraction, never after: a mismatched archive must not
# be unpacked as root. --strict fails on a malformed checklist as well
# as on a mismatch, so a typo in an ARG cannot silently pass.
RUN printf '%s  /tmp/s6-overlay-noarch.tar.xz\n%s  /tmp/s6-overlay-x86_64.tar.xz\n' \
        "$S6_NOARCH_SHA256" "$S6_X86_64_SHA256" \
    | sha256sum --check --strict -

# Install all system packages in a single layer.
# xz-utils is required to extract the s6-overlay .tar.xz archives and is
# not present in bookworm-slim.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        xz-utils \
        postfix \
        dovecot-imapd \
        dovecot-lmtpd \
        opendkim \
        opendkim-tools \
        ca-certificates \
        openssl \
        procps \
    && rm -rf /var/lib/apt/lists/* \
    && tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz \
    && tar -C / -Jxpf /tmp/s6-overlay-x86_64.tar.xz \
    && rm /tmp/s6-overlay-*.tar.xz

# Create vmail user and directories.
RUN groupadd -g 5000 vmail && \
    useradd -u 5000 -g vmail -d /home/vmail -m vmail && \
    mkdir -p /home/vmail/.noombat-admin && \
    chown -R vmail:vmail /home/vmail

# Create the dedicated user for the filtermail content filter (runs
# under a non-root, non-vmail account per Postfix content_filter best
# practice).
RUN useradd -r -s /usr/sbin/nologin filtermail

# Create Postfix access map files and the transport_maps file.
RUN touch /etc/postfix/noombat_recipient_access \
          /etc/postfix/noombat_sender_access \
          /etc/postfix/noombat_transport_maps && \
    postmap /etc/postfix/noombat_recipient_access && \
    postmap /etc/postfix/noombat_sender_access && \
    postmap /etc/postfix/noombat_transport_maps

# Copy Chatmail-specific Postfix and Dovecot configuration.
COPY chatmail-config/main.cf /etc/postfix/main.cf
COPY chatmail-config/dovecot.conf /etc/dovecot/dovecot.conf
COPY chatmail-config/opendkim.conf /etc/opendkim.conf
COPY chatmail-config/master.cf.filtermail /etc/postfix/master.cf.filtermail
COPY chatmail-config/entrypoint.sh /entrypoint.sh
COPY chatmail-config/noombat-doveauth /usr/local/bin/noombat-doveauth
RUN chmod +x /entrypoint.sh /usr/local/bin/noombat-doveauth

# Copy the Rust binaries from the builder stage.
COPY --from=rust-builder /build/target/release/noombat-chatmail-admin /usr/local/bin/noombat-chatmail-admin
COPY --from=rust-builder /build/target/release/noombat-filtermail /usr/local/bin/noombat-filtermail

# ..... S6-OVERLAY SERVICE DEFINITIONS .....

# Dovecot service (started first: provides SASL and LMTP sockets).
RUN mkdir -p /etc/s6-overlay/s6-rc.d/dovecot /etc/s6-overlay/s6-rc.d/user/contents.d
RUN echo "longrun" > /etc/s6-overlay/s6-rc.d/dovecot/type
RUN printf '#!/command/execlineb -P\n/usr/sbin/dovecot -F\n' > /etc/s6-overlay/s6-rc.d/dovecot/run && \
    chmod +x /etc/s6-overlay/s6-rc.d/dovecot/run
RUN touch /etc/s6-overlay/s6-rc.d/user/contents.d/dovecot

# OpenDKIM service (started before Postfix: provides the milter socket).
RUN mkdir -p /etc/s6-overlay/s6-rc.d/opendkim
RUN echo "longrun" > /etc/s6-overlay/s6-rc.d/opendkim/type
RUN printf '#!/command/execlineb -P\n/usr/sbin/opendkim -f\n' > /etc/s6-overlay/s6-rc.d/opendkim/run && \
    chmod +x /etc/s6-overlay/s6-rc.d/opendkim/run
RUN touch /etc/s6-overlay/s6-rc.d/user/contents.d/opendkim

# Postfix service (depends on Dovecot and OpenDKIM).
# The master process is run directly in the foreground (-d flag)
# rather than via `postfix start`, which backgrounds the daemon.
RUN mkdir -p /etc/s6-overlay/s6-rc.d/postfix
RUN echo "longrun" > /etc/s6-overlay/s6-rc.d/postfix/type
RUN printf '#!/command/execlineb -P\n/usr/lib/postfix/sbin/master -d\n' > /etc/s6-overlay/s6-rc.d/postfix/run && \
    chmod +x /etc/s6-overlay/s6-rc.d/postfix/run
RUN printf 'dovecot\nopendkim\n' > /etc/s6-overlay/s6-rc.d/postfix/dependencies
RUN touch /etc/s6-overlay/s6-rc.d/user/contents.d/postfix

# noombat-chatmail-admin sidecar service (no dependencies).
RUN mkdir -p /etc/s6-overlay/s6-rc.d/chatmail-admin
RUN echo "longrun" > /etc/s6-overlay/s6-rc.d/chatmail-admin/type
# `with-contenv` is required: s6-overlay stage0 dumps the container
# environment to /run/s6/container_environment and runs the supervision
# tree without it unless S6_KEEP_ENV is set, leaving the sidecar with no
# CHATMAIL_ADMIN_SECRET to read in `Config::from_env`.
#
# It has to be the script's first command, not part of the shebang:
# Linux passes everything after the interpreter as a single argument, so
# `#!/command/with-contenv execlineb -P` execs a program named
# "execlineb -P".
RUN printf '#!/command/execlineb -P\n/command/with-contenv\n/usr/local/bin/noombat-chatmail-admin\n' > /etc/s6-overlay/s6-rc.d/chatmail-admin/run && \
    chmod +x /etc/s6-overlay/s6-rc.d/chatmail-admin/run
RUN touch /etc/s6-overlay/s6-rc.d/user/contents.d/chatmail-admin

# Expose ports.
EXPOSE 25 465 993 9100

# Volumes.
VOLUME ["/home/vmail"]

# Health check: IMAP NOOP.
HEALTHCHECK --interval=30s --timeout=5s \
    CMD doveadm service status imap || exit 1

ENTRYPOINT ["/entrypoint.sh"]
