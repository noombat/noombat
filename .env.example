# Environment Configuration.
# Copy this file to .env and adjust values for your deployment.
# All Noombat-specific variables are prefixed with NOOMBAT_.

# Instance domain (required).
NOOMBAT_DOMAIN=localhost

# PostgreSQL connection URL (required).
NOOMBAT_DATABASE_URL=postgres://noombat:noombat@localhost/noombat

# Listen address and port (optional, defaults shown).
# NOOMBAT_HOST=0.0.0.0
# NOOMBAT_PORT=8443

# Whether open registration is enabled (default: true).
# NOOMBAT_OPEN_REGISTRATIONS=true

# Development-only bearer token for C2S outbox POST!
# Enables POST /users/{username}/outbox when set.
# To be replaced by full authentication!
# NOOMBAT_ADMIN_TOKEN=noombat

# Meilisearch master key (used by docker-compose).
MEILI_MASTER_KEY=noombat-dev-key

# Logging level (see tracing_subscriber EnvFilter syntax).
RUST_LOG=info,noombat=debug,tower_http=debug
