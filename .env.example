# Environment Configuration.
# Copy this file to .env and adjust values for your deployment.
# All Noombat-specific variables are prefixed with NOOMBAT_.

# Instance domain (required).
NOOMBAT_DOMAIN=localhost

# PostgreSQL connection URL (required).
NOOMBAT_DATABASE_URL=postgres://noombat:noombat@localhost/noombat

# Listen address and port (optional, defaults shown).
# NOOMBAT_HOST=0.0.0.0
# NOOMBAT_PORT=8443

# Whether open registration is enabled (default: true).
# NOOMBAT_OPEN_REGISTRATIONS=true

# Development-only bearer token for C2S outbox POST!
# Enables POST /users/{username}/outbox when set.
# To be replaced by full authentication!
# NOOMBAT_ADMIN_TOKEN=noombat

# Path to the Cedar authorisation policy files (default: policies).
# NOOMBAT_POLICIES_DIR=policies

# Meilisearch master key (used by docker-compose).
MEILI_MASTER_KEY=noombat-dev-key

# Redis connection URL (optional; enables rate limiting and session storage).
# NOOMBAT_REDIS_URL=redis://127.0.0.1:6379

# Logging level (see tracing_subscriber EnvFilter syntax).
RUST_LOG=info,noombat=debug,tower_http=debug

# --- Authentication ---

# JWT signing secret for session tokens (HS256, >= 32 bytes).
# Required for production; if unset, only the admin_token bearer is available.
# NOOMBAT_JWT_SECRET=change-this-to-a-random-secret-at-least-32-bytes-long

# Access-token lifetime in seconds (default: 900 = 15 min).
# NOOMBAT_ACCESS_TTL_SECS=900

# Refresh-token lifetime in seconds (default: 2592000 = 30 days).
# NOOMBAT_REFRESH_TTL_SECS=2592000

# --- ORCID Integration ---

# ORCID OAuth credentials (obtain from https://orcid.org/developer-tools).
# NOOMBAT_ORCID_CLIENT_ID=APP-XXXXXXXXXXXX
# NOOMBAT_ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Encrypted Chat (Chatmail) ---

# Co-deployed Chatmail relay domain (e.g. chat.noombat.social).
# Every instance co-deploys its own Chatmail relay and admin sidecar.
# NOOMBAT_CHATMAIL_DOMAIN=chat.localhost

# Chatmail admin sidecar REST API URL (internal-only, shared-secret auth).
# NOOMBAT_CHATMAIL_ADMIN_URL=http://chatmail-admin:8444

# Shared secret for authenticating requests to the admin sidecar.
# NOOMBAT_CHATMAIL_ADMIN_SECRET=change-this-to-a-random-secret
