# Environment Configuration.
# Copy this file to .env and adjust values for your deployment.
#
# Two kinds of variable live here, and the difference matters:
#
#   * Variables Compose substitutes into the service definitions
#     (MEILI_MASTER_KEY, POSTGRES_PASSWORD, NOOMBAT_KEK and the rest of
#     the production block). These reach the containers.
#
#   * Variables the application reads directly (NOOMBAT_HOST, RUST_LOG,
#     NOOMBAT_DATABASE_URL and so on). On the Compose path these are set
#     in compose.yml's service environment, which wins, so changing them
#     here has no effect. They apply when you run the binary yourself.
#
# As shipped this file starts a localhost development stack:
#
#     cp .env.example .env && podman compose up -d
#
# For production, fill in the block at the end and start with both
# files: `podman compose -f compose.yml -f compose.prod.yml up -d`.

# Instance domain. Anything other than `localhost` turns on the
# production guard rails, which refuse to start with the default
# credentials below.
NOOMBAT_DOMAIN=localhost

# ..... Application settings (bare-metal runs only) .....

# PostgreSQL connection URL. Ignored on the Compose path: compose.yml
# builds this from POSTGRES_PASSWORD and points it at the `db` service.
NOOMBAT_DATABASE_URL=postgres://noombat:noombat@localhost/noombat

# Listen address and port (optional, defaults shown).
# NOOMBAT_HOST=0.0.0.0
# NOOMBAT_PORT=8443

# Whether open registration is enabled (default: true).
# NOOMBAT_OPEN_REGISTRATIONS=true

# Development-only bearer token for C2S outbox POST.
# Enables POST /users/{username}/outbox when set. Omit in production.
# NOOMBAT_ADMIN_TOKEN=noombat

# Redis connection URL (optional; enables rate limiting and session
# storage). Without it the limiter falls back to an in-process one that
# enforces each ceiling approximately rather than exactly.
# NOOMBAT_REDIS_URL=redis://127.0.0.1:6379

# Logging level (see tracing_subscriber EnvFilter syntax).
RUST_LOG=info,noombat=debug,tower_http=debug

# Access-token lifetime in seconds (default: 900 = 15 min).
# NOOMBAT_ACCESS_TTL_SECS=900

# Refresh-token lifetime in seconds (default: 2592000 = 30 days).
# NOOMBAT_REFRESH_TTL_SECS=2592000

# ..... Rate and resource limits (optional; defaults shown) .....

# See docs/deployment.md. Each must be greater than zero, except
# NOOMBAT_DELETION_GRACE_DAYS, where 0 means erase on the next sweep.
# NOOMBAT_RATE_LIMIT=120
# NOOMBAT_RATE_LIMIT_WINDOW_SECS=60
# NOOMBAT_FED_RATE_LIMIT=300
# NOOMBAT_FED_RATE_LIMIT_WINDOW_SECS=60
# NOOMBAT_CV_DOWNLOAD_LIMIT=20
# NOOMBAT_CV_DOWNLOAD_WINDOW_SECS=3600
# NOOMBAT_TYPST_MAX_CONCURRENT=4
# NOOMBAT_TYPST_TIMEOUT_SECS=10
# NOOMBAT_DELETION_GRACE_DAYS=30

# ..... ORCID integration (optional) .....

# Obtain from https://orcid.org/developer-tools.
# NOOMBAT_ORCID_CLIENT_ID=APP-XXXXXXXXXXXX
# NOOMBAT_ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ..... Chatmail (optional) .....

# Co-deployed Chatmail relay domain (e.g. chat.noombat.social).
# Every instance co-deploys its own relay and admin sidecar.
# NOOMBAT_CHATMAIL_DOMAIN=chat.localhost

# Chatmail admin sidecar REST API URL (internal-only).
# NOOMBAT_CHATMAIL_ADMIN_URL=http://chatmail-admin:8444

# ..... Development credentials .....
#
# These start a localhost stack and nothing else. Every one of them is
# refused once NOOMBAT_DOMAIN is not `localhost`, deliberately: the
# server would rather not boot than run in production on a password
# printed in a public repository.

MEILI_MASTER_KEY=noombat-dev-key
CHATMAIL_ADMIN_SECRET=noombat-chatmail-dev-secret
POSTGRES_PASSWORD=noombat

# ..... Telemetry .....
#
# Meilisearch reports to its vendor by default in production mode: a
# per-instance UUID persisted in its data directory, the host's OS,
# kernel version, CPU count, RAM and largest disk, days since first
# start, the document count of every index, and its configuration
# flags. compose.yml sets MEILI_NO_ANALYTICS=true, so a Compose
# deployment does not do this.
#
# Nothing here re-enables it. If you want it on, remove
# MEILI_NO_ANALYTICS from compose.yml deliberately rather than by
# setting a variable, so the choice is visible in the diff.
#
# The per-index document counts are the reason this is off: for a
# federated instance they amount to a periodic report of how large
# your community is, tied to an identifier that survives restarts.

# ..... Production .....
#
# Required by compose.prod.yml. Starting the production stack without
# them fails at `compose up` naming the one that is missing, rather than
# at boot with something less obvious. Replace the three development
# credentials above at the same time.

# Key-encryption key for secrets at rest (TOTP secrets, private keys).
# Without it those are stored as plaintext. 64 hex characters:
#     openssl rand -hex 32
# NOOMBAT_KEK=

# JWT signing secret for session tokens (HS256), at least 32 bytes:
#     openssl rand -base64 48
# NOOMBAT_JWT_SECRET=

# Username promoted to administrator at boot, and only when the
# instance has no administrator at all. Register the account through
# the web interface first, then set this and restart. Later role
# changes go through the administrator interface, and leaving this set
# will not undo them.
# NOOMBAT_BOOTSTRAP_ADMIN=
