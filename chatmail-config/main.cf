#
# Postfix main.cf for the noombat-chatmail container.
#
# This configuration is tailored for a Chatmail relay co-deployed with
# a Noombat instance: encryption-only, closed federation to registered
# Noombat Chatmail domains, and moderation access maps managed by the
# noombat-chatmail-admin sidecar.
#
# MAIL_DOMAIN is substituted at container startup by the entrypoint
# script (envsubst or sed).

# ..... BASIC SETTINGS .....

# Suppress backwards-compatibility warnings (Postfix 3.7 on bookworm).
compatibility_level = 3.6

myhostname = MAIL_DOMAIN
mydomain = MAIL_DOMAIN
myorigin = $mydomain
# mydestination must not overlap with virtual_mailbox_domains.
# The mail domain is handled by virtual_mailbox_domains below.
mydestination = localhost.$mydomain, localhost
mynetworks = 127.0.0.0/8 [::1]/128

# Relay restrictions: permit SASL-authenticated clients to relay mail
# to remote domains. This does not bypass the recipient restrictions
# below, i.e. Postfix evaluates both restriction lists independently,
# and all must pass.
smtpd_relay_restrictions =
    permit_sasl_authenticated,
    reject_unauth_destination

# ..... LOGGING .....

# Postfix logs through syslog by default and this image runs no syslog
# daemon, so without this every rejection, deferral and TLS error is
# discarded.
maillog_file = /dev/stdout

# ..... TLS .....

# TLS certificate paths (populated by the container entrypoint or
# Let's Encrypt integration).
smtpd_tls_cert_file = /etc/ssl/certs/chatmail.pem
smtpd_tls_key_file = /etc/ssl/private/chatmail.key
smtpd_tls_security_level = may
smtp_tls_security_level = may
smtpd_tls_auth_only = yes

# ..... SASL (Dovecot) .....

smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes

# ..... VIRTUAL MAILBOX .....

virtual_mailbox_domains = $mydomain
virtual_mailbox_base = /home/vmail
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000

# Use LMTP to deliver to Dovecot.
virtual_transport = lmtp:unix:private/dovecot-lmtp

# ..... CLOSED FEDERATION .....

# transport_maps routes outbound SMTP to registered Noombat Chatmail
# domains. The allowlist file is generated by the sidecar's
# allowlist synchronisation mechanism.
transport_maps = hash:/etc/postfix/noombat_transport_maps

# default_transport rejects delivery to any domain not present in
# transport_maps, enforcing the closed federation policy. Without
# this, Postfix would fall back to the built-in smtp transport and
# deliver to arbitrary domains.
default_transport = error:5.7.1 Delivery restricted to registered Noombat Chatmail domains

# ..... MODERATION ACCESS MAPS .....

# check_recipient_access: reject inbound mail to suspended or deleted
# addresses. Managed by the noombat-chatmail-admin sidecar.
# The access map check precedes permit_sasl_authenticated so that
# blocked recipients are rejected even from authenticated senders.
smtpd_recipient_restrictions =
    check_recipient_access hash:/etc/postfix/noombat_recipient_access,
    permit_sasl_authenticated,
    reject_unauth_destination

# check_sender_access: reject mail from blocked senders (per-pair
# moderation), then close the inbound half of the federation policy.
#
# transport_maps decides where this relay sends; the sender-domain map
# decides who it accepts from. With only the first, an unlisted domain can
# deliver here and the reply is refused, which is a dead end rather than a
# closed federation.
#
# Unconditional, to match `default_transport` above: with no allowlist
# both maps are empty and the relay is closed in both directions rather
# than accepting mail it could never answer. Local chat is unaffected,
# because submission is authenticated and re-injection overrides these
# restrictions.
smtpd_sender_restrictions =
    check_sender_access hash:/etc/postfix/noombat_sender_access,
    permit_mynetworks,
    permit_sasl_authenticated,
    check_sender_access hash:/etc/postfix/noombat_sender_domains,
    reject

# ..... INBOUND FEDERATION .....

# smtpd_client_restrictions with a check_client_access table can
# restrict inbound SMTP connections to known Chatmail relay IPs.
# For domain-level enforcement, the sender restrictions above
# combined with the transport_maps provide the bidirectional
# closed federation guarantee.

# ..... DKIM .....

# OpenDKIM milter for DKIM signing on outbound mail.
#
# `tempfail`, not `accept`. With `accept`, a crashed or misconfigured
# OpenDKIM is indistinguishable from a working one: mail keeps flowing,
# unsigned, and the first sign of it is a peer relay rejecting messages
# from this domain, days later, for a reason visible only at their end.
#
# `tempfail` answers 4xx instead, so the sending client retries and the
# mail is delivered once the milter is back. The cost of the wrong
# choice is asymmetric: a deferral is minutes of delay, while silent
# unsigned delivery is a domain reputation nobody here can observe
# losing.
milter_default_action = tempfail
milter_protocol = 6

# A numeric address, not `localhost`. With `tempfail` above, one failed
# lookup answers every connection on 25 with `451` and the relay accepts
# nothing, so the failure path should not depend on a resolver at all.
#
# Reaches the re-injection listener only. Both public listeners empty
# `smtpd_milters`, because a before-queue filter cannot run a milter
# that touches headers and signing adds one, so nothing is signed until
# the filter has accepted it.
smtpd_milters = inet:127.0.0.1:8891

# Mail submitted with sendmail(1) rather than over SMTP: bounces, and
# anything an operator sends by hand. The normal path does not reach it.
non_smtpd_milters = inet:127.0.0.1:8891

# ..... ENCRYPTION-ONLY ENFORCEMENT .....

# `noombat-filtermail` refuses any message that is not PGP-encrypted,
# as a before-queue filter: the public listeners in master.cf carry
# `smtpd_proxy_filter`, so the refusal is a `550` at end-of-DATA with
# nothing spooled and no bounce.
#
# No `content_filter` here, and no after-queue filter anywhere. An
# after-queue refusal can only be a bounce, which mails the sender's
# plaintext back out. A global `content_filter` also applies to
# `pickup`, which loops a filter's own re-injection back through it
# until the hopcount bounces.

# ..... LIMITS .....

# 30 MiB, matching the Chatmail reference relay's `max_message_size`
# default rather than Postfix's own 10240000. Clients are written
# against the reference: a 20 MiB attachment that every other Chatmail
# host accepts would be permanently rejected here, which reads to the
# user as this instance being broken.
message_size_limit = 31457280

# ..... MISCELLANEOUS .....

# Chatmail optimisations: small queue, fast delivery.
maximal_queue_lifetime = 1d
bounce_queue_lifetime = 1d
minimal_backoff_time = 30s
maximal_backoff_time = 300s
