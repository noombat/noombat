#
# Postfix master.cf snippet: defines the submission listener on 465 and
# the filtermail content filter as a pipe(8) service.
#
# Appended to /etc/postfix/master.cf by the container entrypoint, which
# also puts `content_filter` on the inbound listener on 25 and turns
# milters off for `pickup`. Those two live in the base image's
# master.cf, so they are edited in place rather than declared here.
#
# The filtermail service runs as the unprivileged 'filtermail' user.
# Mail the filter accepts is re-injected with sendmail(1), which submits
# through `postdrop` and `pickup`. Neither carries `content_filter`, so
# the message is not filtered a second time. That is the whole loop
# prevention: not the `-o content_filter=` that sendmail(1) documents as
# ignored, and that this configuration used to rely on.

# Submission over implicit TLS (RFC 8314), which is the port the
# application server connects to. Postfix ships this listener commented
# out, so it has to be declared here or nothing answers on 465.
#
# The numeric port rather than the `submissions` service name, so this
# does not depend on /etc/services in the base image.
#
# `content_filter` per listener and not in main.cf, because a global one
# also applies to `pickup`, which is the path the filter re-injects on,
# and the accepted message loops back into the filter until Postfix
# bounces it for too many hops. See main.cf for the measurement.
465       inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/submissions
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o content_filter=filtermail:dummy

# filtermail content filter (pipe transport).
filtermail unix  -       n       n       -       10      pipe
  flags=Rq user=filtermail argv=/usr/local/bin/noombat-filtermail -f ${sender} -- ${recipient}
