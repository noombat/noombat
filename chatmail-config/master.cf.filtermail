#
# Postfix master.cf snippet: the submission listener on 465, and the
# re-injection listener the encryption filter hands accepted mail to.
#
# Appended to /etc/postfix/master.cf by the container entrypoint, which
# also puts the proxy filter on the inbound listener on 25. That one
# comes from the base image's master.cf, so it is edited in place.
#
# The path a message takes, and the filter listens on a different port
# per direction because the checks differ:
#
#   user  -- smtpd :465 -- filtermail :10026 -- smtpd :10025 -- queue
#   peer  -- smtpd :25  -- filtermail :10027 -- smtpd :10025 -- queue
#
# Postfix hands the message to the filter during the SMTP conversation
# and takes its end-of-DATA answer as the answer to the client, so a
# refusal is a `550` on the sender's own connection with nothing spooled
# and no bounce.

# Submission over implicit TLS (RFC 8314), which is the port the
# application server connects to. Postfix ships this listener commented
# out, so it has to be declared here or nothing answers on 465.
#
# The numeric port rather than the `submissions` service name, so this
# does not depend on /etc/services in the base image.
#
# `smtpd_milters` is emptied: a before-queue filter cannot run a milter
# that touches headers, and signing adds one. The re-injection listener
# below signs instead, so a refused message never is.
465       inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/submissions
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_proxy_filter=127.0.0.1:10026
  -o smtpd_milters=

# Re-injection listener: what the filter accepted, and the only path
# into the queue. Loopback only.
#
# `smtpd_authorized_xforward_hosts` lets the filter forward the original
# client's address, so the logs and the `Received:` header name the real
# sender rather than 127.0.0.1.
#
# `smtpd_proxy_filter` is emptied explicitly, because a global one would
# point this listener back at the filter the message just came from.
127.0.0.1:10025 inet  n  -       n       -       -       smtpd
  -o syslog_name=postfix/reinject
  -o smtpd_proxy_filter=
  -o receive_override_options=no_unknown_recipient_checks,no_header_body_checks
  -o smtpd_helo_restrictions=
  -o smtpd_client_restrictions=
  -o smtpd_sender_restrictions=
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o mynetworks=127.0.0.0/8
  -o smtpd_authorized_xforward_hosts=127.0.0.0/8
