# Caddyfile for Noombat production deployment.
#
# Replace {$NOOMBAT_DOMAIN} with the actual domain, or set the
# environment variable before starting Caddy.

{
    # The address Let's Encrypt mails expiry and policy notices to.
    #
    # The same NOOMBAT_CONTACT_EMAIL the application uses, not a second
    # address written here. Two addresses drift: this one is read once a
    # year, by a machine, in a message nobody expects, so a stale value
    # here is discovered when a certificate has already expired. Sharing
    # the variable means the address is wrong in the places an operator
    # looks at daily, or it is right here too.
    #
    # Caddy substitutes an unset variable with the empty string and
    # registers an ACME account with no contact rather than failing, so
    # compose.prod.yml demands the variable with `:?`. That fails at
    # `compose up`, naming it, instead of ninety days later.
    email {$NOOMBAT_CONTACT_EMAIL}
}

{$NOOMBAT_DOMAIN} {
    reverse_proxy noombat:8443

    # Only Strict-Transport-Security is set here.
    #
    # Every other security header is emitted by the application, in
    # crates/noombat-api/src/middleware.rs (`security_headers`). Two
    # reasons:
    #
    #   1. A deployment that terminates TLS elsewhere, or that runs
    #      without any reverse proxy, is then protected identically.
    #   2. Browsers enforce multiple Content-Security-Policy headers as
    #      an intersection. That is safe, but it means a policy can be
    #      tightened in one place and silently contradicted in the
    #      other. A single authoritative emitter removes the drift.
    #
    # HSTS is the deliberate exception: browsers honour it only over
    # TLS, so it belongs with the TLS terminator.
    #
    # The application sets each header only when absent, so a value
    # added here overrides the application's.
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    }

    encode gzip
}

# The Chatmail relay's hostname.
#
# Caddy serves nothing here. The block exists so that Caddy obtains and
# renews a publicly trusted certificate for `chat.`, which Postfix and
# Dovecot then serve on 993 and 465. Without it those two present a
# certificate no client accepts, and Delta Chat, the client this project
# tells users to prefer, refuses to connect.
#
# HTTP-01 and not DNS-01. DNS-01 needs a Caddy binary carrying
# DNS-provider modules, which the digest-pinned upstream image does not
# ship, so taking it would mean building and pinning our own Caddy. That
# digest pinning is load-bearing for the reproducibility claims in
# SECURITY.md, and this problem occurs once. The cost of HTTP-01 is that
# `chat.<domain>` must resolve and answer on port 80, which is a record
# the operator is creating for the relay anyway.
#
# The relay reads the result out of Caddy's storage volume; see the
# `cert-watch` service in Dockerfile.chatmail. Caddy owns acquisition and
# renewal, the relay owns reloading the daemons.
chat.{$NOOMBAT_DOMAIN} {
    respond "This hostname serves mail, not web." 404
}
