# Caddyfile for Noombat production deployment.
#
# Replace {$NOOMBAT_DOMAIN} with the actual domain, or set the
# environment variable before starting Caddy.

{$NOOMBAT_DOMAIN} {
    reverse_proxy noombat:8443

    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
    }

    encode gzip
}
