# HTTPS in front of Noombat for the browser check (run.sh, check 19), which
# loads the chat page at https://test.local. Caddy's own CA signs the
# certificate, and the browser is told to accept it.

{
	local_certs
}

https://test.local {
	reverse_proxy noombat:8443
}
